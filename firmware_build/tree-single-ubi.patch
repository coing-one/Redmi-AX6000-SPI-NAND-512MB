diff --git a/target/linux/mediatek/dts/mt7986a-xiaomi-redmi-router-ax6000-single.dts b/target/linux/mediatek/dts/mt7986a-xiaomi-redmi-router-ax6000-single.dts
new file mode 100644
index 0000000..4089f82
--- /dev/null
+++ b/target/linux/mediatek/dts/mt7986a-xiaomi-redmi-router-ax6000-single.dts
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+
+/dts-v1/;
+#include "mt7986a-xiaomi-redmi-router-ax6000.dtsi"
+
+/ {
+	model = "Xiaomi Redmi Router AX6000 (single UBI layout)";
+	compatible = "xiaomi,redmi-router-ax6000-single", "mediatek,mt7986a";
+};
+
+&spi_nand_flash {
+	mediatek,nmbm;
+	mediatek,bmt-max-ratio = <1>;
+	mediatek,bmt-max-reserved-blocks = <64>;
+};
+
+&partitions {
+	partition@580000 {
+		label = "crash";
+		reg = <0x580000 0x40000>;
+		read-only;
+	};
+
+	partition@5c0000 {
+		label = "crash_log";
+		reg = <0x5c0000 0x40000>;
+		read-only;
+	};
+
+	partition@600000 {
+		label = "ubi";
+		reg = <0x600000 0x1ea00000>;
+	};
+};
