# honk 预置配置（本仓库定版，编译时覆盖 daeuniverse 包自带的骨架配置，装到 /etc/honk/config.dae）
#
# 设计口径（与现行 SmartDNS+Nikki 方案的差异要看清）：
# - honk 服务默认不开机自启（包自带 uci-defaults 会关掉），Nikki/SmartDNS 照常工作，零风险。
# - 手动启用 honk 前：先停用 Nikki 与 SmartDNS（两者与 honk 都是透明代理/DNS 接管，不能同开），
#   再在 doona（http://路由器IP:9527）里填订阅，然后 /etc/init.d/honk enable && start。步骤见同目录 README.md。
# - 订阅链接涉及个人凭据，本仓库是公开仓库，这里只留占位注释，真实链接在路由器上填，不要提交进仓库。
# - 本地无任何节点时 honk 也能启动（订阅未拉到时节点为空），先填订阅再启用最省事。

global {
    wan_interface: auto
    lan_interface: br-lan
    log_level: info
    # domain++：按本站 DNS 路由的结果拨号，配合下面的响应校验，国内 CDN 命中率最好
    dial_mode: domain++
    auto_config_kernel_parameter: true
    data_dir: '/etc/honk/data'
    log_file: ''
    tcp_check_url: 'https://www.gstatic.com/generate_204'
    tcp_check_http_method: HEAD
    udp_check_dns: 'dns.google.com:53,8.8.8.8'
    check_interval: 30s
    check_tolerance: 50ms
    # 节点与订阅域名防回环解析走国内公共 DNS 直连（上游 DoH 都用 IP 形式，不依赖它）
    bootstrap_resolver: '223.5.5.5:53'
    nfqueue_enable: true
}

# 订阅：在 doona 里加，或把下面两行取消注释改成本人的链接（二选一即可）
# subscription {
#     mysub: 'https://example.com/your-subscription'
# }

group {
    # 全部节点一个组，score 策略按真实流量表现自动选节点（honk 的主打策略，免调参）
    proxy {
        policy: score
    }
}

dns {
    ipversion_prefer: 4
    # 直连上游自动携带客户端近似网段（ECS），国内 CDN 就近命中；代理上游不携带
    client_subnet: auto
    # 热缓存：正答统一 600 秒、5 万条；过期先顶上再后台刷新靠提前刷新实现，重启后由 cache_file 落盘恢复
    optimistic_cache: true
    optimistic_cache_ttl: 600
    max_cache_size: 50000
    upstream {
        # 国内：阿里 DoH（IP 形式免引导解析）直连
        alidns: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com' -> direct
        # 国外：Google DoH（IP 形式）经代理组，未污染且带国外 CDN 视角
        googledns: 'https://8.8.8.8/dns-query?tls_server_name=dns.google' -> proxy
    }
    routing {
        request {
            qname(geosite: gfw) -> googledns
            # 油管全家先走国外解析，避免拿到被调度到国内/受限区的地址
            qname(suffix: googlevideo.com) -> googledns
            qname(suffix: youtube.com) -> googledns
            qname(suffix: ytimg.com) -> googledns
            qname(suffix: ggpht.com) -> googledns
            fallback: alidns
        }
        response {
            # 响应校验（honk/dae 的防污染打法）：国外上游与内网域名直接采信；
            # 国内上游的答复只有解析到国内 IP 才采信，否则换国外上游重查
            upstream(googledns) -> accept
            qname(geosite: private) -> accept
            ip(geoip: cn) -> accept
            fallback: googledns
        }
    }
}

routing {
    # 路由器本机 DNS 进程直连，防解析回环
    pname(dnsmasq, smartdns) && l4proto(udp) && dport(53) -> direct(must)
    dip(geoip: private) -> direct(must)
    dip(geoip: cn) -> direct
    domain(geosite: geolocation-cn) -> direct
    # 油管 QUIC 与现行 Nikki 口径一致：UDP 443 拦下逼回 TCP（链路上有 UDP 断点）
    domain(geosite: youtube) && l4proto(udp) && dport(443) -> block
    domain(geosite: google) -> proxy
    fallback: proxy
}

experimental {
    clash_api {
        external_controller: '127.0.0.1:9090'
        default_mode: 'Rule'
    }
    native_api {
        enabled: true
        listen: '0.0.0.0:9527'
        password_auth: true
        config_write: true
        ui: 'embedded'
    }
    cache_file {
        enabled: true
        # DNS 正缓存落盘，重启后缓存不凉（油管秒开靠它一半）
        store_dns: true
    }
}
